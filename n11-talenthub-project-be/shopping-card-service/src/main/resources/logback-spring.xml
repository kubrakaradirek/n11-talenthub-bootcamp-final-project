<configuration>
    <!-- Konsol Cikitisi -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
        Dosya cikistini /tmp'e yaziyoruz cunku Spring Boot buildpack image'inda
        /workspace yazilamayan bir dizin olabiliyor. /tmp her container'da
        yazilabilir oldugundan yapilandirma her ortamda calisir.
        LOG_DIR ortam degiskeni set edilirse onu kullanir, yoksa /tmp'e duser.
    -->
    <property name="LOG_DIR" value="${LOG_DIR:-/tmp}" />

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/shopping-cart.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/shopping-cart.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
    </root>
</configuration>
